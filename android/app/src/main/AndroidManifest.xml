<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="io.akmoor25.koala_portfolio">

    <!-- 意図しないAD_ID権限を削除 -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <!-- 再起動後もウィジェットの工程切り替えアラームを再登録する -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- しおりに参加するときに QR コードを読み取る。カメラが無い端末にも入れられるようにする -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Android 13 以降で、共同編集の通知（参加、しおりの削除と停止）を表示する -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher">
        <!-- 利用者が「はじめる」を押すまで、Crashlytics の送信と FCM の自動初期化を止める。
             アプリが、「はじめる」のあとに有効にする（lib/helper/data_collection.dart） -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <!-- 通知の小さなアイコンと、チャンネル（MainActivity が同じ ID で作る） -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_koala" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="collab" />
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <!-- Android プロセス起動直後からこの Activity に適用するテーマ。
                 Flutter UI の初期化中に表示され、その後も Flutter UI の背後の背景を決める。 -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"
            />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ホーム画面ウィジェット (Glance) -->
        <receiver
            android:name=".widget.KoalaWidgetReceiver"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/koala_widget_info" />
        </receiver>
        <receiver
            android:name="es.antonborri.home_widget.HomeWidgetScheduledUpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action
                    android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 以下の meta-data は削除しないこと。
             Flutter ツールが GeneratedPluginRegistrant.java の生成に使う。 -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>